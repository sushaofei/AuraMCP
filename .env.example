# AuraMCP 平台库（治理数据：扩展开关 / Catalog / 审计）。
# 复制为 .env 后填写真实值；.env 禁止提交。
# Tool / Resource / Prompt 的能力数据不要用这组变量。

AURAMCP_DEPLOYMENT_PROFILE=development
AURAMCP_HOST=127.0.0.1
AURAMCP_PORT=8020
AURAMCP_LOG_LEVEL=INFO

# production 必须提供，且 AURAMCP_ALLOW_INSECURE_IDENTITY 不能为 true
AURAMCP_HANDS_WORKLOAD_TOKEN=
# 须与 AuraClaw 共享 Vault 中 vault/auramcp#workload 相同（开发：10.244.16.132:8200）
AURAMCP_ADMIN_TOKEN=
AURAMCP_ALLOW_INSECURE_IDENTITY=true

AURAMCP_PLATFORM_STORE=postgres
AURAMCP_DB_TYPE=postgresql
AURAMCP_DB_HOST=
AURAMCP_DB_PORT=5432
AURAMCP_DB_USER=
AURAMCP_DB_PASSWORD=
# 缺省数据库名为 auramcp，需事先创建：CREATE DATABASE auramcp;
AURAMCP_DB_NAME=auramcp
AURAMCP_DB_SSLMODE=prefer

# Optional database capability. Separate, protected configuration; never use AURAMCP_DB_*
# for business records. See docs/数据库查询与分析.md. Omit to disable the extension.
# AURAMCP_ANALYTICS_CONFIG_FILE=/run/config/analytics.json
# Secret file alternatives: AURAMCP_HANDS_WORKLOAD_TOKEN_FILE,
# AURAMCP_ADMIN_TOKEN_FILE, AURAMCP_DB_PASSWORD_FILE.
# Optional Cube capability; separate from governance and source credentials.
# AURAMCP_SEMANTIC_CONFIG_FILE=/run/config/semantic.json
