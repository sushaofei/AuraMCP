# AuraMCP 平台库（治理数据：扩展开关 / Catalog / 审计）。
# 复制为 .env 后填写真实值；.env 禁止提交。
# Tool / Resource / Prompt 的能力数据不要用这组变量。

AURAMCP_DEPLOYMENT_PROFILE=development
AURAMCP_HOST=127.0.0.1
AURAMCP_PORT=8020
AURAMCP_LOG_LEVEL=INFO

# production 必须提供，且 AURAMCP_ALLOW_INSECURE_IDENTITY 不能为 true
AURAMCP_HANDS_WORKLOAD_TOKEN=
AURAMCP_ADMIN_TOKEN=
AURAMCP_ALLOW_INSECURE_IDENTITY=true

AURAMCP_PLATFORM_STORE=postgres
AURAMCP_DB_TYPE=postgresql
AURAMCP_DB_HOST=
AURAMCP_DB_PORT=5432
AURAMCP_DB_USER=
AURAMCP_DB_PASSWORD=
# 缺省数据库名为 auramcp，需事先创建：CREATE DATABASE auramcp;
AURAMCP_DB_NAME=auramcp
AURAMCP_DB_SSLMODE=prefer
